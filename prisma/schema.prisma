datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id                String   @id @default(uuid())
  employeeCode      String   @unique
  fullName          String
  email             String   @unique
  joinDate          DateTime
  terminationDate   DateTime?
  employmentStatus  String   // ACTIVE, PROBATION, OFFBOARDING, TERMINATED
  currentTitle      String
  currentDepartment String
  currentProject    String?
  currentManager    String?
  avatarUrl         String?
  location          String?  @default("Ho Chi Minh City")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events            EmployeeEvent[]
  documents         Document[]
  trainingRecords   TrainingRecord[]
  performanceReviews PerformanceReview[]
  competencyAssessments CompetencyAssessment[]
  attendanceSummaries AttendanceSummary[]
  offboardingCases  OffboardingCase[]

  // Hybrid Architecture additions
  records           Record[]
  walletTransactions WalletTransaction[]
  rewardRequests    RewardRequest[]
  
  // Phase 2 Additions
  compensationRecords CompensationRecord[]
  paymentRecords    PaymentRecord[]
}

model EmployeeEvent {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventType      String    // RECRUITMENT, INTERVIEW, OFFER, ONBOARD, CONTRACT, PROBATION, TRAINING, PERFORMANCE_REVIEW, COMPETENCY_REVIEW, SALARY_CHANGE, TRANSFER, APPOINTMENT, CONCURRENT_ASSIGNMENT, PROJECT_CHANGE, BUSINESS_TRIP, RESIGNATION, EXIT_INTERVIEW, HANDOVER, TERMINATION
  eventDate      DateTime
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  title          String
  description    String?
  oldValue       String?
  newValue       String?
  status         String    @default("COMPLETED") // COMPLETED, IN_PROGRESS, CANCELLED
  sourceRecordId String?
  createdAt      DateTime  @default(now())

  documents      Document[]
}

model Document {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventId         String?
  event           EmployeeEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  documentType    String    // CV, INTERVIEW_EVALUATION, OFFER_LETTER, LABOUR_CONTRACT, PROBATION_ASSESSMENT, TRAINING_CERTIFICATE, PERFORMANCE_REVIEW, COMPETENCY_ASSESSMENT, SALARY_DECISION, TRANSFER_DECISION, APPOINTMENT_DECISION, CONCURRENT_ASSIGNMENT_DECISION, RESIGNATION_LETTER, EXIT_INTERVIEW_FORM, HANDOVER_RECORD, FINAL_TIMESHEET, TERMINATION_AGREEMENT
  documentTitle   String
  documentDate    DateTime
  effectiveDate   DateTime?
  fileName        String
  fileType        String    // pdf, docx, png, jpg
  sourceSystem    String    // SharePoint, OneDrive, Local HR Folder, Google Drive
  sourcePath      String
  sourceUrl       String?
  version         String    @default("1.0")
  documentStatus  String    @default("VALID") // VALID, CANCELLED, SUPERSEDED, EXPIRED, DRAFT
  parentDocumentId String?
  relationshipType String?  // CANCELS, SUPERSEDES, AMENDS, EXTENDS, REFERENCES
  createdAt       DateTime  @default(now())

  parentDocument  Document?  @relation("DocumentHistory", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childDocuments  Document[] @relation("DocumentHistory")
}

model TrainingRecord {
  id                            String   @id @default(uuid())
  employeeId                    String
  employee                      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseCode                    String
  courseName                    String
  trainingType                  String   // Internal, External, Certification, Workshop
  startDate                     DateTime
  completionDate                DateTime
  learningHours                 Float
  learningHoursInsideWorkingTime Float
  learningHoursOutsideWorkingTime Float
  score                         Float?
  result                        String   // Passed, Distinction, Completed, In Progress
  certificateUrl                String?
  createdAt                     DateTime @default(now())
}

model PerformanceReview {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewPeriod     String   // 2023 H1, 2023 Annual, 2024 H1, 2024 Annual, 2025 Annual
  reviewDate       DateTime
  reviewType       String   // Annual, Mid-Year, Probation
  performanceScore Float
  rating           String   // Exceeds Expectations, Meets Expectations, Outstanding, Needs Improvement
  reviewer         String
  documentId       String?
  createdAt        DateTime @default(now())
}

model CompetencyAssessment {
  id             String            @id @default(uuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewPeriod   String
  assessmentDate DateTime
  createdAt      DateTime          @default(now())

  scores         CompetencyScore[]
}

model CompetencyScore {
  id                 String               @id @default(uuid())
  assessmentId       String
  assessment         CompetencyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyName     String
  competencyCategory String               // Technical, Soft Skills, Leadership, Core Values
  requiredLevel      Int
  actualLevel        Int
  gap                Int
}

model AttendanceSummary {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  standardWorkingDays Int
  actualWorkingDays  Float
  workingHours       Float
  paidLeaveDays      Float
  unpaidLeaveDays    Float
  lateCount          Int
  earlyLeaveCount    Int
  otHours            Float
  weekdayOtHours     Float
  weekendOtHours     Float
  holidayOtHours     Float
  createdAt          DateTime @default(now())
}

model OffboardingCase {
  id                         String   @id @default(uuid())
  employeeId                 String
  employee                   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resignationDate            DateTime
  lastWorkingDate            DateTime
  status                     String   // IN_PROGRESS, COMPLETED, CANCELLED
  resignationDone            Boolean  @default(false)
  exitInterviewDone          Boolean  @default(false)
  handoverDone               Boolean  @default(false)
  finalTimesheetDone         Boolean  @default(false)
  assetReturnDone            Boolean  @default(false)
  terminationAgreementSigned Boolean  @default(false)
  socialInsuranceDone        Boolean  @default(false)
  createdAt                  DateTime @default(now())
}

// --- HYBRID METADATA DRIVEN ARCHITECTURE ---

model Module {
  id              String            @id @default(uuid())
  name            String
  description     String?
  icon            String?
  isSystem        Boolean           @default(false)
  isActive        Boolean           @default(true)
  lifecycleCategory String?         // RECRUITMENT, EMPLOYMENT, COMPENSATION, etc.
  displayOrder    Int               @default(0)
  isEmployeeRelated Boolean         @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  fields          FieldDefinition[]
  records         Record[]
}

model FieldDefinition {
  id              String            @id @default(uuid())
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  fieldName       String
  fieldKey        String            // snake_case key
  dataType        String            // TEXT, LONG_TEXT, NUMBER, INTEGER, PERCENTAGE, CURRENCY, DATE, DATETIME, BOOLEAN, SINGLE_SELECT, MULTI_SELECT, EMPLOYEE_REFERENCE, etc.
  isRequired      Boolean           @default(false)
  defaultValue    String?
  selectOptions   String?           // JSON string of options
  displayOrder    Int               @default(0)
  isActive        Boolean           @default(true)
  isVisible       Boolean           @default(true)
  isEditable      Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  values          RecordValue[]
}

model Record {
  id              String            @id @default(uuid())
  moduleId        String
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  employeeId      String?           
  employee        Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  values          RecordValue[]
  relatedTo       RecordRelationship[] @relation("SourceRecord")
  relatedFrom     RecordRelationship[] @relation("TargetRecord")
}

model RecordValue {
  id              String            @id @default(uuid())
  recordId        String
  record          Record            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fieldId         String
  field           FieldDefinition   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  
  stringValue     String?           // For TEXT, LONG_TEXT, SELECT
  numberValue     Float?            // For NUMBER, PERCENTAGE, CURRENCY
  dateValue       DateTime?         // For DATE, DATETIME
  booleanValue    Boolean?          // For BOOLEAN
}

model RecordRelationship {
  id               String           @id @default(uuid())
  sourceRecordId   String
  sourceRecord     Record           @relation("SourceRecord", fields: [sourceRecordId], references: [id], onDelete: Cascade)
  targetRecordId   String
  targetRecord     Record           @relation("TargetRecord", fields: [targetRecordId], references: [id], onDelete: Cascade)
  relationshipType String           // RELATED_TO, CREATED_FROM, SUPERSEDES, REPLACES, CANCELS
}

// --- CAREER & COMPETENCY METADATA ---

model Skill {
  id              String            @id @default(uuid())
  name            String
  category        String
  description     String?
  maxLevel        Int               @default(5)
  createdAt       DateTime          @default(now())
}

model Competency {
  id              String            @id @default(uuid())
  name            String
  category        String
  description     String?
  createdAt       DateTime          @default(now())
}

model RoleProfile {
  id              String            @id @default(uuid())
  title           String
  department      String?
  level           String?
  createdAt       DateTime          @default(now())
}

model CareerPath {
  id              String            @id @default(uuid())
  name            String
  description     String?
  createdAt       DateTime          @default(now())
}

// --- KNOWLEDGE REWARD SYSTEM ---

model RewardRule {
  id              String            @id @default(uuid())
  ruleName        String
  activityType    String
  measurementUnit String
  conversionRate  Float
  maxReward       Float?
  frequencyLimit  String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          String            @default("ACTIVE")
  approvalRequired Boolean          @default(false)
  createdAt       DateTime          @default(now())
}

model WalletTransaction {
  id              String            @id @default(uuid())
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Float
  transactionType String            // EARNED, REDEEMED, EXPIRED, CANCELLED
  description     String
  sourceRef       String?           // Link to training record, etc.
  status          String            @default("COMPLETED")
  createdAt       DateTime          @default(now())
}

model RewardItem {
  id              String            @id @default(uuid())
  name            String
  category        String
  description     String?
  coinCost        Float
  stock           Int?
  imageUrl        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())

  requests        RewardRequest[]
}

model RewardRequest {
  id              String            @id @default(uuid())
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rewardItemId    String
  rewardItem      RewardItem        @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
  coinCost        Float
  status          String            @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED, CANCELLED
  requestDate     DateTime          @default(now())
  fulfilledDate   DateTime?
  comments        String?
}

model AuditLog {
  id              String            @id @default(uuid())
  userId          String            
  action          String            // CREATE, UPDATE, DELETE, ARCHIVE
  entityType      String            // Module, Record, Employee, etc.
  entityId        String
  oldValue        String?           
  newValue        String?           
  timestamp       DateTime          @default(now())
}
// --- PHASE 2 MODELS ---

model CompensationRecord {
  id String @id @default(uuid())
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  grossSalary Float
  socialInsuranceSalary Float
  baseSalary Float
  allowance Float
  otherAllowance Float
  currency String
  compensationType String
  reason String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  
  allowanceComponents AllowanceComponent[]
}

model AllowanceComponent {
  id String @id @default(uuid())
  compensationRecordId String
  compensationRecord CompensationRecord @relation(fields: [compensationRecordId], references: [id], onDelete: Cascade)
  name String
  amount Float
  currency String
}

model PaymentRecord {
  id String @id @default(uuid())
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paymentType String
  paymentDate DateTime
  grossAmount Float
  taxableAmount Float
  taxAmount Float
  netAmount Float
  currency String
  taxMethod String
  paymentPeriod String
  description String?
  createdAt DateTime @default(now())
}
